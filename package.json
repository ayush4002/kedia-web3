{
    "private": true,
    "name": "kedia-web",
    "scripts": {
        "build": "npm run build:vendor && npm run build:css",
        "build:vendor": "node scripts/copy-vendor.mjs",
        "build:css": "tailwindcss -c tailwind.config.js -i resources/css/site.css -o public/assets/site.css --minify",
        "watch:css": "tailwindcss -c tailwind.config.js -i resources/css/site.css -o public/assets/site.css --watch"
    },
    "devDependencies": {
        "gsap": "^3.13.0",
        "lenis": "^1.3.4",
        "qrcode-generator": "^1.4.4",
        "tailwindcss": "3.4.17"
    }
}
