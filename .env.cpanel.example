# ====================================================================
# cPanel Production Environment Configuration for Kedia Builders
# Copy this file to .env on your cPanel server and update the values.
# ====================================================================

APP_NAME="Kedia Builders & Colonizers"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="Asia/Kolkata"
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

# ====================================================================
# cPanel MySQL Database Credentials (Created in cPanel MySQL Databases)
# ====================================================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpanelusername_kediadb
DB_USERNAME=cpanelusername_kediauser
DB_PASSWORD="your_strong_password_here"

# Session & Cache (File-based is optimal for shared cPanel hosting)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX="kedia_cache_"

# Contact Form & System Emails
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=info@yourdomain.com
MAIL_PASSWORD="your_email_password"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"


# Admin console (/admin) HTTP Basic Auth.
ADMIN_USER=admin
ADMIN_PASSWORD="change_me_to_strong_password"

# One-time web setup page (/cpanel-setup?key=kedia2026_cpanel_setup).
CPANEL_SETUP_KEY=kedia2026_cpanel_setup
